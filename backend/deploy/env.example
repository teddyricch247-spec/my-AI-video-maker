# Names only. NEVER put values in this file or in git.
# Real values live in ~/.vbeat/env on the worker (chmod 600, created empty by bootstrap.sh) or in the host's secret store.
DATABASE_URL=                 # Supabase SESSION POOLER connection string (IPv4; the direct db.<ref>.supabase.co host is IPv6-only)
SUPABASE_URL=                 # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # service role key (server only, never a browser)
OPENROUTER_API_KEY=
TICK_SECRET=                  # shared with the planner; guards /wake and /preflight
WORKER_ID=                    # stable and unique: worker-1 ... worker-9  (a restarted worker re-adopts ITS OWN orphaned jobs by this id)
WORKER_SLOTS=3                # beats at once on this worker
VBEAT_MAX_HEAVY=2             # Chromium/ffmpeg processes at once on this worker
VBEAT_LEDGER_TZ=UTC           # time zone whose midnight starts "today" for the daily cap, e.g. Europe/Berlin
# Optional
PORT=8080                     # the status app; a Sprite's URL routes to 8080 by default
WORKER_PUBLIC_URL=            # shown on the Ops page (the Sprite URL)
VBEAT_WORK_DIR=               # scratch directory (default /tmp/vbeat-work); wiped per job
VBEAT_LOG_LEVEL=INFO
