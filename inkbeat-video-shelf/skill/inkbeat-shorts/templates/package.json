{
  "name": "inkbeat-shorts-project",
  "version": "1.0.0",
  "private": true,
  "description": "A Remotion + three.js / React Three Fiber starter for toon-shaded 3D cartoon videos",
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.540",
    "@remotion/three": "4.0.540",
    "@types/three": "0.186.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "bundle": "remotion bundle src/index.ts --out-dir=build",
    "still": "remotion still src/index.ts Demo out/demo.jpg --gl=angle --timeout=240000",
    "typecheck": "tsc --noEmit"
  }
}
