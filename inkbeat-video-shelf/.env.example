# OPTIONAL. The project is already wired in config/shelf.json, so nothing here is required.
# Set any of these only to point the shelf at a different Supabase project.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=      # only if you later lock the bucket down
# SUPABASE_BUCKET=videos
